            background: white;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            margin: 20px auto;
            position: relative;
            flex-shrink: 0;
        }
        canvas { display: block; }
        .annotation-canvas { position: absolute; top: 0; left: 0; }
        
        #editor-view.tool-select .textLayer { pointer-events: auto; z-index: 20; }
        #editor-view.tool-select .annotation-canvas { pointer-events: none; z-index: 1; }

        #editor-view.tool-draw .textLayer { pointer-events: none; z-index: 1; }
        #editor-view.tool-draw .annotation-canvas { pointer-events: auto; z-index: 20; cursor: crosshair; }

        #editor-view.tool-highlight .textLayer { pointer-events: none; z-index: 1; }
        #editor-view.tool-highlight .annotation-canvas { pointer-events: auto; z-index: 20; cursor: crosshair; }

        #editor-view.tool-eraser .textLayer { pointer-events: none; z-index: 1; }
        #editor-view.tool-eraser .annotation-canvas { pointer-events: auto; z-index: 20; cursor: pointer; }

        .textLayer {
            position: absolute; left: 0; top: 0; right: 0; bottom: 0;
            overflow: hidden; opacity: 1 !important; line-height: 1.0;
        }
        .textLayer span {
            color: transparent; position: absolute; white-space: pre; cursor: text; transform-origin: 0% 0%;
        }
        .textLayer span::selection {
            background: rgba(37, 99, 235, 0.4) !important; color: transparent !important;
        }
        #sidebar.collapsed { width: 0 !important; min-width: 0 !important; padding: 0 !important; overflow: hidden; border: none; }
    </style>
