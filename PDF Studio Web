    <!-- SCRIPT DE CONTROL Y VISOR -->
    <script>
        // Manejo de Cookies
        const cookieBanner = document.getElementById('cookie-banner');
        if (localStorage.getItem('cookies_accepted')) {
            cookieBanner.style.display = 'none';
        }
        document.getElementById('accept-cookies').addEventListener('click', () => {
            localStorage.setItem('cookies_accepted', 'all');
            cookieBanner.style.display = 'none';
        });
        document.getElementById('reject-cookies').addEventListener('click', () => {
            localStorage.setItem('cookies_accepted', 'essential');
            cookieBanner.style.display = 'none';
        });

        const homeView = document.getElementById('home-view');
        const editorView = document.getElementById('editor-view');
        const navHomeBtn = document.getElementById('nav-home-btn');
        const navEditorBtn = document.getElementById('nav-editor-btn');
        const heroTryWeb = document.getElementById('hero-try-web');

        function showHome() {
            homeView.classList.remove('hidden');
            editorView.classList.add('hidden');
            navHomeBtn.className = "bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow transition flex items-center space-x-2";
            navEditorBtn.className = "bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-xl text-sm font-semibold border border-slate-700 transition flex items-center space-x-2";
        }

        function showEditor() {
            homeView.classList.add('hidden');
            editorView.classList.remove('hidden');
            navEditorBtn.className = "bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow transition flex items-center space-x-2";
            navHomeBtn.className = "bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-xl text-sm font-semibold border border-slate-700 transition flex items-center space-x-2";
        }

        navHomeBtn.addEventListener('click', showHome);
        navEditorBtn.addEventListener('click', showEditor);
        heroTryWeb.addEventListener('click', showEditor);

        let pdfDoc = null;
        let scale = 1.5;
        let currentTool = 'select';
        let currentColor = '#000000';
        let currentBrushSize = 6;
        let pageAnnotations = {};
        let lastX = 0, lastY = 0;

        const synth = window.speechSynthesis;
        let currentUtterance = null;
        let isPaused = false;
        let availableVoices = [];

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
        }

        function loadVoices() {
            availableVoices = synth.getVoices();
            const voiceSelect = document.getElementById('voice-select');
            if (!voiceSelect) return;
            voiceSelect.innerHTML = '';
            
            const spanishVoices = availableVoices.filter(v => v.lang && v.lang.toLowerCase().startsWith('es'));
            const voicesToUse = spanishVoices.length > 0 ? spanishVoices : availableVoices;

            voicesToUse.forEach((voice) => {
                const option = document.createElement('option');
                option.value = availableVoices.indexOf(voice);
                option.textContent = `${voice.name} (${voice.lang})`;
                voiceSelect.appendChild(option);
            });
        }

        synth.onvoiceschanged = loadVoices;
        loadVoices();
        setTimeout(loadVoices, 500);

        const fileInput = document.getElementById('file-input');
        const viewerContainer = document.getElementById('viewer-container');
        const pagesContainer = document.getElementById('pages-container');
        const welcomeScreen = document.getElementById('welcome-screen');
        const thumbnailsContainer = document.getElementById('sidebar-content-thumbs');
        const outlineContainer = document.getElementById('sidebar-content-outline');
        const sidebar = document.getElementById('sidebar');

        viewerContainer.addEventListener('dragover', (e) => e.preventDefault());
        viewerContainer.addEventListener('drop', async (e) => {
            e.preventDefault();
            const file = e.dataTransfer.files[0];
            if (file && file.type === 'application/pdf') {
                const reader = new FileReader();
                reader.onload = async function() {
                    await loadPDF(new Uint8Array(this.result));
                };
                reader.readAsArrayBuffer(file);
            }
        });

        document.getElementById('toggle-sidebar-btn').addEventListener('click', () => sidebar.classList.toggle('collapsed'));

        const tabThumbs = document.getElementById('tab-thumbs');
        const tabOutline = document.getElementById('tab-outline');
        tabThumbs.addEventListener('click', () => {
            tabThumbs.className = "flex-1 py-2 text-center bg-slate-50 border-b-2 border-blue-600 text-blue-600";
            tabOutline.className = "flex-1 py-2 text-center hover:bg-slate-50 text-slate-600";
            thumbnailsContainer.classList.remove('hidden');
            outlineContainer.classList.add('hidden');
        });
        tabOutline.addEventListener('click', () => {
            tabOutline.className = "flex-1 py-2 text-center bg-slate-50 border-b-2 border-blue-600 text-blue-600";
            tabThumbs.className = "flex-1 py-2 text-center hover:bg-slate-50 text-slate-600";
            outlineContainer.classList.remove('hidden');
            thumbnailsContainer.classList.add('hidden');
        });

        const ttsBtn = document.getElementById('tts-btn');
        const ttsLabel = document.getElementById('tts-label');
        const ttsStopBtn = document.getElementById('tts-stop-btn');

        ttsBtn.addEventListener('click', async () => {
            if (!pdfDoc) { showToast("Primero abre un PDF."); return; }
            if (synth.paused) { synth.resume(); isPaused = false; ttsLabel.textContent = "Pausar"; return; }
            if (synth.speaking && !isPaused) { synth.pause(); isPaused = true; ttsLabel.textContent = "Reanudar"; return; }

            ttsLabel.textContent = "Cargando...";
            let fullText = "";
            for (let i = 1; i <= pdfDoc.numPages; i++) {
                const page = await pdfDoc.getPage(i);
                const textContent = await page.getTextContent();
                fullText += textContent.items.map(item => item.str).join(' ') + "\n\n";
            }
            fullText = fullText.replace(/\s+/g, ' ').trim();

            if (!fullText) { showToast("PDF sin texto seleccionable."); ttsLabel.textContent = "Leer"; return; }

            synth.cancel();
            currentUtterance = new SpeechSynthesisUtterance(fullText);
            const selectedVoiceIndex = document.getElementById('voice-select').value;
            if (selectedVoiceIndex !== "" && availableVoices[selectedVoiceIndex]) {
                currentUtterance.voice = availableVoices[selectedVoiceIndex];
            }

            currentUtterance.onstart = () => { ttsLabel.textContent = "Pausar"; ttsStopBtn.classList.remove('hidden'); };
            currentUtterance.onend = () => { ttsLabel.textContent = "Leer"; ttsStopBtn.classList.add('hidden'); isPaused = false; };
            synth.speak(currentUtterance);
        });

        ttsStopBtn.addEventListener('click', () => {
            synth.cancel(); isPaused = false; ttsLabel.textContent = "Leer"; ttsStopBtn.classList.add('hidden');
        });

        fileInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file) {
                synth.cancel();
                const reader = new FileReader();
                reader.onload = async function() { await loadPDF(new Uint8Array(this.result)); };
                reader.readAsArrayBuffer(file);
            }
        });

        async function loadPDF(data) {
            try {
                const loadingTask = pdfjsLib.getDocument({ data: data, stopAtErrors: false });
                pdfDoc = await loadingTask.promise;
                pageAnnotations = {};
                if(welcomeScreen) welcomeScreen.remove();
                await renderAllPages();
                await loadOutline();
                showToast(`PDF cargado (${pdfDoc.numPages} páginas)`);
            } catch (err) {
                showToast("Error al abrir el archivo PDF.");
            }
        }

        async function renderAllPages() {
            pagesContainer.innerHTML = '';
            thumbnailsContainer.innerHTML = '';
            for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
                await renderPage(pageNum);
                renderThumbnail(pageNum);
            }
        }

        async function renderPage(pageNum) {
            const page = await pdfDoc.getPage(pageNum);
            const outputScale = Math.max(window.devicePixelRatio || 1, 2);
            const viewport = page.getViewport({ scale: scale });

            const wrapper = document.createElement('div');
            wrapper.className = 'pdf-page-wrapper';
            wrapper.style.width = `${viewport.width}px`;
            wrapper.style.height = `${viewport.height}px`;
            wrapper.dataset.pageNumber = pageNum;

            const canvas = document.createElement('canvas');
            canvas.width = Math.floor(viewport.width * outputScale);
            canvas.height = Math.floor(viewport.height * outputScale);
            canvas.style.width = `${viewport.width}px`;
            canvas.style.height = `${viewport.height}px`;
            
            await page.render({ canvasContext: canvas.getContext('2d'), transform: [outputScale, 0, 0, outputScale, 0, 0], viewport: viewport }).promise;
            wrapper.appendChild(canvas);

            const textLayerDiv = document.createElement('div');
            textLayerDiv.className = 'textLayer';
            textLayerDiv.style.width = `${viewport.width}px`;
            textLayerDiv.style.height = `${viewport.height}px`;
            wrapper.appendChild(textLayerDiv);

            try {
                const textContent = await page.getTextContent();
                await pdfjsLib.renderTextLayer({ textContentSource: textContent, container: textLayerDiv, viewport: viewport, textDivs: [] }).promise;
            } catch (e) {}

            const annotCanvas = document.createElement('canvas');
            annotCanvas.className = 'annotation-canvas';
            annotCanvas.width = canvas.width;
            annotCanvas.height = canvas.height;
            annotCanvas.style.width = `${viewport.width}px`;
            annotCanvas.style.height = `${viewport.height}px`;
            wrapper.appendChild(annotCanvas);

            const annotCtx = annotCanvas.getContext('2d');
            annotCtx.scale(outputScale, outputScale);

            if (!pageAnnotations[pageNum]) pageAnnotations[pageNum] = [];
            else redrawCanvas(annotCtx, pageAnnotations[pageNum]);

            setupAnnotationEvents(annotCanvas, annotCtx, pageNum);
            pagesContainer.appendChild(wrapper);
        }

        function setupAnnotationEvents(canvas, ctx, pageNum) {
            let drawing = false;
            const getCoords = (e) => {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return { x: clientX - rect.left, y: clientY - rect.top };
            };

            const startDraw = (e) => {
                if (currentTool === 'select') return;
                if (e.cancelable) e.preventDefault();
                const { x, y } = getCoords(e);
                if (currentTool === 'eraser') { eraseAt(x, y, pageNum, ctx); drawing = true; return; }
                drawing = true; lastX = x; lastY = y;
            };

            const moveDraw = (e) => {
                if (!drawing || currentTool === 'select') return;
                if (e.cancelable) e.preventDefault();
                const { x, y } = getCoords(e);
                if (currentTool === 'eraser') { eraseAt(x, y, pageNum, ctx); return; }

                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(x, y);

                if (currentTool === 'draw') {
                    ctx.strokeStyle = currentColor; ctx.lineWidth = currentBrushSize; ctx.globalAlpha = 1.0;
                } else {
                    ctx.strokeStyle = currentColor; ctx.lineWidth = currentBrushSize * 3.5; ctx.globalAlpha = 0.45;
                }
                ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.stroke();
                ctx.globalAlpha = 1.0;

                pageAnnotations[pageNum].push({
                    type: currentTool, x1: lastX, y1: lastY, x2: x, y2: y,
                    color: currentColor, size: ctx.lineWidth, alpha: currentTool === 'highlight' ? 0.45 : 1.0
                });
                lastX = x; lastY = y;
            };

            canvas.addEventListener('mousedown', startDraw);
            canvas.addEventListener('mousemove', moveDraw);
            window.addEventListener('mouseup', () => { drawing = false; });
            canvas.addEventListener('touchstart', startDraw, { passive: false });
            canvas.addEventListener('touchmove', moveDraw, { passive: false });
            window.addEventListener('touchend', () => { drawing = false; });
        }

        function eraseAt(x, y, pageNum, ctx) {
            if (!pageAnnotations[pageNum]) return;
            pageAnnotations[pageNum] = pageAnnotations[pageNum].filter(item => Math.hypot(item.x1 - x, item.y1 - y) > 25);
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
            redrawCanvas(ctx, pageAnnotations[pageNum]);
        }

        function redrawCanvas(ctx, annotations) {
            annotations.forEach(item => {
                ctx.beginPath(); ctx.moveTo(item.x1, item.y1); ctx.lineTo(item.x2, item.y2);
                ctx.strokeStyle = item.color; ctx.lineWidth = item.size; ctx.globalAlpha = item.alpha || 1.0;
                ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.stroke();
                ctx.globalAlpha = 1.0;
            });
        }

        async function renderThumbnail(pageNum) {
            const page = await pdfDoc.getPage(pageNum);
            const viewport = page.getViewport({ scale: 0.15 });
            const canvas = document.createElement('canvas');
            canvas.width = viewport.width; canvas.height = viewport.height;
            canvas.className = 'cursor-pointer rounded border border-slate-200 hover:border-blue-500 shadow-sm transition';
            await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
            canvas.addEventListener('click', () => {
                const target = document.querySelector(`[data-page-number="${pageNum}"]`);
                if(target) target.scrollIntoView({ behavior: 'smooth' });
            });
            thumbnailsContainer.appendChild(canvas);
        }

        async function loadOutline() {
            outlineContainer.innerHTML = '';
            try {
                const outline = await pdfDoc.getOutline();
                if (!outline || outline.length === 0) {
                    outlineContainer.innerHTML = '<p class="text-xs text-slate-400 text-center mt-4">Sin índice disponible</p>';
                    return;
                }
                const ul = document.createElement('ul');
                ul.className = 'space-y-1 pl-1';
                async function renderItems(items, parent) {
                    for (let item of items) {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.textContent = item.title;
                        a.className = 'text-blue-600 hover:underline cursor-pointer block truncate py-0.5';
                        a.addEventListener('click', async (e) => {
                            e.preventDefault();
                            if (item.dest) {
                                let dest = item.dest;
                                if (typeof dest === 'string') dest = await pdfDoc.getDestination(dest);
                                if (dest) {
                                    const pageIndex = await pdfDoc.getPageIndex(dest[0]);
                                    const target = document.querySelector(`[data-page-number="${pageIndex + 1}"]`);
                                    if(target) target.scrollIntoView({ behavior: 'smooth' });
                                }
                            }
                        });
                        li.appendChild(a);
                        if (item.items && item.items.length > 0) {
                            const sub = document.createElement('ul');
                            sub.className = 'pl-3 space-y-1 border-l border-slate-200 mt-1';
                            await renderItems(item.items, sub);
                            li.appendChild(sub);
                        }
                        parent.appendChild(li);
                    }
                }
                await renderItems(outline, ul);
                outlineContainer.appendChild(ul);
            } catch (e) {
                outlineContainer.innerHTML = '<p class="text-xs text-slate-400 text-center mt-4">Sin índice disponible</p>';
            }
        }

        document.querySelectorAll('.tool-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('bg-blue-50', 'text-blue-600'));
                btn.classList.add('bg-blue-50', 'text-blue-600');
                currentTool = btn.dataset.tool;
                editorView.className = `flex-1 flex flex-col overflow-hidden tool-${currentTool}`;
            });
        });

        document.querySelectorAll('.color-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('ring-2', 'ring-offset-1', 'ring-blue-500'));
                btn.classList.add('ring-2', 'ring-offset-1', 'ring-blue-500');
                currentColor = btn.dataset.color;
            });
        });

        document.getElementById('brush-size').addEventListener('input', (e) => { currentBrushSize = e.target.value; });

        document.getElementById('save-btn').addEventListener('click', async () => {
            if (!pdfDoc) { showToast("Primero abre un PDF."); return; }
            showToast("Generando archivo PDF editado...");
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF();
            for (let i = 1; i <= pdfDoc.numPages; i++) {
                if (i > 1) pdf.addPage();
                const wrapper = document.querySelector(`[data-page-number="${i}"]`);
                const canvases = wrapper.querySelectorAll('canvas');
                const combined = document.createElement('canvas');
                combined.width = canvases[0].width; combined.height = canvases[0].height;
                const ctx = combined.getContext('2d');
                ctx.drawImage(canvases[0], 0, 0);
                if (canvases[1]) ctx.drawImage(canvases[1], 0, 0);
                
                const imgData = combined.toDataURL('image/jpeg', 0.95);
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (canvases[0].height * pdfWidth) / canvases[0].width;
                pdf.addImage(imgData, 'JPEG', 0, 0, pdfWidth, pdfHeight);
            }
            pdf.save("documento-editado.pdf");
            showToast("¡PDF descargado con éxito!");
        });
    </script>
</body>
</html>